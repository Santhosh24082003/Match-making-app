# MongoDB Atlas connection string (leave empty to use in-memory MongoDB locally)
MONGODB_URI=
MONGODB_DB=datecrew_mvp

JWT_SECRET=your-secret-here
CLIENT_ORIGIN=http://localhost:5173

# Data source for customers + profiles at runtime:
#   mongodb = read from MongoDB (default)
#   json    = read directly from src/data/json/*.json files
DATA_SOURCE=mongodb

# Optional Gemini key for match explanations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
